{
  "$schema": "https://turborepo.com/schema.json",
  "globalPassThroughEnv": [
    "NEXT_TELEMETRY_DISABLED",
    "EXPO_NO_TELEMETRY",
    "TURBO_TELEMETRY_DISABLED"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
